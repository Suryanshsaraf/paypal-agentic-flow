# ===============================================================
# GitBounty AI - Environment Configuration
# ===============================================================

# PayPal Developer Sandbox Credentials
# Get yours from https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Google Gemini AI API Key (for automated AST code analysis & security audits)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token (Optional: for real GitHub API webhook / comments)
GITHUB_BOT_TOKEN=your_github_personal_access_token

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
